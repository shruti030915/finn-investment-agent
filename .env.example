# FINN — Financial Investment Intelligence Agent Configuration

# Server Configuration
FINN_HOST=0.0.0.0
FINN_PORT=8000
FINN_DEBUG=True

# LLM Providers (Optional - FINN includes an intelligent deterministic financial reasoning fallback if no key is supplied)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Default Alert Thresholds (Configurable via UI)
DEFAULT_PRICE_MOVE_THRESHOLD=3.0     # Percentage (e.g. ±3.0%)
DEFAULT_VOLUME_MULT_THRESHOLD=2.0     # Multiple of 20-day moving average (e.g. 2.0x)
DEFAULT_DIGEST_WINDOW_HOURS=24       # Hours to look back for portfolio digest

# Data Feed Mode: 'live' or 'demo'
FINN_DATA_MODE=live
